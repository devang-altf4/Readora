APP_NAME=Dindle API
APP_ENV=development
API_V1_PREFIX=/api/v1

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=dindle
MONGODB_TEST_DATABASE=dindle_test

STORAGE_BACKEND=local
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=100

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://10.0.2.2:8081
