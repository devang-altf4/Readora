APP_NAME=Readora API
APP_ENV=production
API_V1_PREFIX=/api/v1

# Put the real URI in Render's secret environment variables, never in git.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=readora
AUTH_SESSION_DAYS=30

# For a Render persistent disk, use /var/data/storage. Without a disk this is ephemeral.
STORAGE_BACKEND=local
STORAGE_ROOT=/var/data/storage
MAX_UPLOAD_SIZE_MB=100
LOG_LEVEL=INFO
CORS_ORIGINS=*
